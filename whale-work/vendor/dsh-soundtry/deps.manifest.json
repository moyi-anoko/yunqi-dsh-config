    "modes":  {
                  "borrow":  {
                                 "desc":  "借用机器上已有的 Python（有 torch 即可，例如 ComfyUI 自带的那个）。torch / torchaudio / numpy / librosa 全部沿用那边的，插件 venv 只装自己需要的三个包。磁盘增量约 110 MB。",
                                 "requires":  "一个装了 torch 的 Python 3.10–3.12",
                                 "pip":  [
                                             "faster-whisper\u003e=1.0",
                                             "demucs\u003e=4.0",
                                             "torchcrepe\u003e=0.0.23"
                                         ],
                                 "mirror":  "https://pypi.tuna.tsinghua.edu.cn/simple",
                                 "forceInstall":  [
                                                      "onnxruntime\u003e=1.16"
                                                  ]
                             },
                  "standalone":  {
                                     "desc":  "整套装进插件 venv，不依赖机器上任何现成环境（ComfyUI 删了也不影响）。磁盘增量约 7 GB，torch 轮子下载约 2.5 GB。",
                                     "requires":  "任意 Python 3.10–3.12",
                                     "torchIndex":  "https://download.pytorch.org/whl/cu129",
                                     "torchPackages":  [
                                                           "torch",
                                                           "torchaudio"
                                                       ],
                                     "pip":  [
                                                 "faster-whisper\u003e=1.0",
                                                 "demucs\u003e=4.0",
                                                 "torchcrepe\u003e=0.0.23",
                                                 "numpy\u003e=1.24",
                                                 "scipy\u003e=1.10",
                                                 "librosa\u003e=0.10",
                                                 "soundfile\u003e=0.12"
                                             ],
                                     "mirror":  "https://pypi.tuna.tsinghua.edu.cn/simple",
                                     "note":  "torch 走 PyTorch 官方 cu129 索引，其余走清华镜像。",
                                     "forceInstall":  [
                                                          "onnxruntime\u003e=1.16"
                                                      ]
                                 }
              },
    "borrowedFromBase":  {
                             "desc":  "borrow 模式下这些由基础解释器提供，插件不装（这就是省下 7 GB 的部分）",
                             "packages":  [
                                              "torch",
                                              "torchaudio",
                                              "numpy",
                                              "scipy",
                                              "librosa",
                                              "soundfile",
                                              "onnxruntime",
                                              "ctranslate2",
